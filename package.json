{
  "name": "@lunarianbyte/baileys",
  "version": "1.0.7",
  "description": "Baileys Modifications That Are Useful for WhatsApp Bot ESM & CJS maintenance by @lunarianbyte/baileys",
  "keywords": [
    "baileys",
    "baileys-mod",
    "wabot",
    "whatsapp",
    "js-whatsapp",
    "whatsapp-api",
    "whatsapp-web",
    "whatsapp-bot",
    "automation",
    "multi-device",
    "@lunarianbyte/baileys"
  "homepage": "https://github.com/lunarianbyte/baileys/",
  "repository": {
    "url": "git@github.com:lunarianbyte/baileys.git"
  },
  "license": "MIT",
  "author": "XyraaDeLunar",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.json",
    "WAProto/**/*",
    "engine-requirements.js"
  ],
    "scripts": {
    "changelog:update": "conventional-changelog -p @lunarianbyte/baileys.js -i CHANGELOG.md -s -r 0",
    "changelog:preview": "conventional-changelog -p @lunarianbyte/baileys.js -u",
    "changelog:last": "conventional-changelog -p @lunarianbyte/baileys.js -r 2",
    "gen:protobuf": "sh WAProto/GenerateStatics.sh",
    "example": "node --inspect Example/example.js",
    "lint": "eslint src --ext .js",
    "lint:fix": "yarn lint --fix",
    "release": "release-it",
    "test": "jest",
    "update:version": "node scripts/Update-version.js"
  },
  
  "dependencies": {
    "@cacheable/node-cache": "^1.4.0",
    "@hapi/boom": "^9.1.3",
    "async-mutex": "^0.5.0",
    "cache-manager": "latest",
    "fflate": "latest",
    "libsignal": "git+https://github.com/whiskeysockets/libsignal-node",
    "lru-cache": "^11.1.0",
    "music-metadata": "^11.7.0",
    "p-queue": "^9.0.0",
    "pino": "^9.6",
    "protobufjs": "^7.2.4",
    "ws": "^8.13.0"
  },
  "peerDependencies": {
    "audio-decode": "^2.1.3",
    "jimp": ">=0.16.1 <=1.6.0",
    "link-preview-js": "^3.0.0",
    "sharp": "*"
  },
  "peerDependenciesMeta": {
    "audio-decode": {
      "optional": true
    },
    "jimp": {
      "optional": true
    },
    "link-preview-js": {
      "optional": true
    }
  },
  "packageManager": "yarn@4.9.2",
  "engines": {
    "node": ">=20.0.0"
  }
}
